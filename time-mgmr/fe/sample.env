# Tempo — local development environment
# Restart `npm run dev` after changing these values.

# Auth
# Accept any valid email + password (min 8 chars) when mock auth is on.

VITE_AUTH_STORAGE_STRATEGY=httpOnly

# API (unused while mock auth is enabled; set when a backend exists)


# Module Federation / Webpack (optional — used by `npm run dev:mf`)
MF_MODE=standalone
MF_NAME=tempo
PORT=3000
# MF_REMOTES=profile=profile@http://localhost:3001/remoteEntry.js
# MF_EXPOSES=./App=./src/app/App

VITE_API_URL=
VITE_MOCK_AUTH=false
VITE_DISABLE_AUTH=false